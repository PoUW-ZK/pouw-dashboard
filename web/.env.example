# Defaults connect to the real API and hide PoUW screens for the demo.
# For a deterministic UI preview without Hasura, set VITE_USE_MOCKS=true.
VITE_USE_MOCKS=false
VITE_SHOW_POUW=false

# Public devnet reward addresses. Override to match NODE[_2/_3]_MINER_ADDRESS
# in pouw-deploy if the network uses different reward keys.
